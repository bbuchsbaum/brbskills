{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Discovery inventory, not a preprocessing-readiness certificate",
  "required": [
    "schema_version",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "selected"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "selected": {
            "type": "boolean"
          },
          "subject": {
            "type": [
              "string",
              "null"
            ]
          },
          "task": {
            "type": [
              "string",
              "null"
            ]
          },
          "tr": {
            "type": [
              "number",
              "null"
            ]
          },
          "nvols": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  }
}
