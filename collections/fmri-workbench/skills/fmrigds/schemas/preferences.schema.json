{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Explicit, conditional preferences; never an authorization store",
  "required": [
    "schema_version",
    "preferences",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "value",
          "when",
          "source",
          "confirmed_at",
          "evidence"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^(communication|first_level|group|reporting|compute|x)\\.[a-z0-9_.-]+$"
          },
          "when": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "source": {
            "const": "explicit_user"
          },
          "confirmed_at": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
