{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "COBIDAS local event 0.1.0",
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "locator",
        "kind"
      ],
      "oneOf": [
        {
          "required": [
            "path",
            "sha256"
          ],
          "not": {
            "required": [
              "uri"
            ]
          }
        },
        {
          "required": [
            "uri",
            "version"
          ],
          "not": {
            "required": [
              "path"
            ]
          }
        }
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "kind": {
          "const": "fact"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "by": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "planned",
            "actual"
          ]
        },
        "status": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "value": {},
        "basis": {
          "enum": [
            "observed",
            "derived",
            "documented",
            "reported",
            "inferred"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "activity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string"
        },
        "missing_details": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "kind",
        "recorded_at",
        "scope",
        "by",
        "key",
        "phase",
        "status",
        "value",
        "basis",
        "evidence",
        "activity_ids",
        "supersedes"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              },
              "evidence": {
                "minItems": 1
              }
            }
          },
          "else": {
            "required": [
              "reason"
            ],
            "properties": {
              "value": {
                "type": "null"
              },
              "reason": {
                "minLength": 1
              },
              "missing_details": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "kind": {
          "const": "activity"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "by": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "status": {
          "enum": [
            "planned",
            "running",
            "succeeded",
            "partial",
            "failed"
          ]
        },
        "software": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "identity": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "invocation": {
          "type": "object",
          "minProperties": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "evidence"
          ],
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_run"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidence"
              }
            }
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "kind",
        "recorded_at",
        "scope",
        "by",
        "status",
        "software",
        "invocation",
        "inputs",
        "outputs",
        "validation",
        "depends_on"
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "kind": {
          "const": "decision"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "by": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "result_exposure": {
          "enum": [
            "none",
            "qc_only",
            "relevant_results",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "affects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "recorded_at",
        "scope",
        "by",
        "decision",
        "reason",
        "result_exposure",
        "evidence",
        "affects"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/fact"
    },
    {
      "$ref": "#/$defs/activity"
    },
    {
      "$ref": "#/$defs/decision"
    }
  ]
}
