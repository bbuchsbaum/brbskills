{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace",
    "project_id",
    "report_title",
    "scopes"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "report_title": {
      "type": "string",
      "minLength": 1
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "profiles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "kind": {
            "enum": [
              "study",
              "acquisition",
              "analysis"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "profiles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
