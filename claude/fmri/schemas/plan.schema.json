{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "fMRI workbench plan envelope; stage_configs hold reviewed native specifications, not a code DSL",
  "required": [
    "schema_version",
    "analysis_id",
    "scope",
    "stage_configs",
    "decisions",
    "checks",
    "fingerprints",
    "budget",
    "data_policy",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "discovery",
          "first_level",
          "group",
          "report"
        ]
      }
    },
    "stage_configs": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "stage",
          "value",
          "status",
          "material"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "stage": {
            "enum": [
              "shared",
              "discovery",
              "first_level",
              "group",
              "report"
            ]
          },
          "status": {
            "enum": [
              "unresolved",
              "proposed",
              "confirmed",
              "observed"
            ]
          },
          "material": {
            "type": "boolean"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "stage",
          "status",
          "blocking",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "stage": {
            "enum": [
              "shared",
              "discovery",
              "first_level",
              "group",
              "report"
            ]
          },
          "status": {
            "enum": [
              "not_checked",
              "pass",
              "fail",
              "blocked",
              "not_applicable"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "approved",
        "cpu_hours",
        "max_workers",
        "max_memory_gb"
      ],
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "cpu_hours": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_workers": {
          "type": "integer",
          "minimum": 1
        },
        "max_memory_gb": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "data_policy": {
      "type": "object",
      "required": [
        "model_visible",
        "sharing"
      ],
      "properties": {
        "model_visible": {
          "enum": [
            "unresolved",
            "aggregate_only",
            "approved_subject_level",
            "synthetic"
          ]
        },
        "sharing": {
          "type": "string"
        }
      }
    },
    "approval": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
